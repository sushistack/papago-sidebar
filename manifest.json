{
  "manifest_version": 3,
  "name": "Papago Sidebar",
  "description": "Papago (papago.naver.com) sidebar panel for Firefox",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "papago-sidebar@sushistack.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Papago",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://papago.naver.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_unblock",
        "enabled": true,
        "path": "rules/frame_unblock.json"
      }
    ]
  }
}
